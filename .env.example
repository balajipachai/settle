# Copy to .env (repo root or backend/). Secrets never go in code, prompts, logs, or audit events.

# fixture = offline, deterministic fixture adapters | live = Gmail + Stripe TEST mode + HubSpot + Slack
SETTLE_MODE=fixture
# auto = Claude if ANTHROPIC_API_KEY is set, else the deterministic rules reasoner | claude | rules
SETTLE_REASONER=auto
ANTHROPIC_API_KEY=
SETTLE_CLAUDE_MODEL=claude-opus-5
SETTLE_PUBLIC_BASE_URL=http://localhost:8000
# Optional comma-separated allow-list of approvers, e.g. slack:U0123ABCD,dashboard.reviewer
SETTLE_APPROVER_IDS=

# Stripe: TEST mode keys only (sk_test_ / rk_test_). Startup fails on live keys without an operator override.
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=
ALLOW_LIVE_STRIPE_WRITES=false

# HubSpot private app token (scopes: crm.objects.companies/contacts/deals read+write, crm.schemas.companies.write)
HUBSPOT_ACCESS_TOKEN=

# Slack app: bot token (chat:write), channel id, and signing secret for the Interactivity endpoint
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# Gmail OAuth client + refresh token for the support mailbox (scopes: gmail.modify, gmail.send)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_INBOX_QUERY=in:inbox newer_than:30d
# Optional. The post-verification demo reply is sent here. Leave blank to use a
# +settle-demo alias of the authorized support mailbox, keeping the rehearsal self-contained.
SETTLE_DEMO_CUSTOMER_EMAIL=

# Optional Postgres (default is SQLite under backend/data). Requires: uv add psycopg[binary] langgraph-checkpoint-postgres
# DATABASE_URL=postgresql+psycopg://settle:settle@localhost:5432/settle

# Optional LangSmith tracing (graph nodes + LLM calls)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
